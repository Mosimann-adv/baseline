<?xml version="1.0" encoding="utf-8"?>
<!-- Sem backup na nuvem: a fila offline e a sessão ficam só neste aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
